# Postgres
DB_PORT=15432
DB_NAME=AdaIsAkademi
DB_USER=
DB_PASS=

# Redis
REDIS_PORT=16379
REDIS_PASSWORD=
REDIS_CONFIG_ENABLED=true
REDIS_CONFIG_INSTANCE_NAME=AdaIsAkademi:
REDIS_CONFIG_CONNECTION=

# MinIO (root şifresi en az 8 karakter)
MINIO_PORT=19000
MINIO_PORT_SECURE=19001
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=ada-is-akademi

OBJECT_STORAGE_SERVICE_URL=http://ada-is-akademi-minio:9000
OBJECT_STORAGE_PUBLIC_SERVICE_URL=http://localhost:19000
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET_NAME=ada-is-akademi
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_REGION_NAME=us-east-1

# pgAdmin
DBVIEW_PORT=15050
DBVIEW_USER=admin@local.dev
DBVIEW_PASSWORD=

# API
API_PORT=15080
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_ENVIRONMENT=Development
JWT_ISSUER=AdaIsAkademi
JWT_AUDIENCE=AdaIsAkademi.Api
JWT_SIGNING_KEY=
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

EMAIL_ENABLED=false

# docker compose --profile backup
BACKUP_CRON_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_RESTORE_SMOKE=false
BACKUP_TZ=Europe/Istanbul
